    "second": {
      "direction": "column",
      "splitPercentage": 30,
      "first": "RawMessages!patrolstatus",
      "second": {
        "direction": "column",
        "splitPercentage": 16,
        "first": {
          "direction": "row",
          "splitPercentage": 33,
          "first": "Publish!start",
          "second": {
            "direction": "row",
            "splitPercentage": 50,
            "first": "Publish!gohome",
            "second": "Publish!stop"
          }
        },
        "second": {
          "direction": "column",
          "splitPercentage": 50,
          "first": "Plot!speed",
          "second": "RosOut!log"
        }
      }
    }
