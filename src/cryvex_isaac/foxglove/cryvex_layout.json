    "RawMessages!patrolstatus": {
      "topicPath": "/patrol_status.data",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false,
      "expansion": "all"
    },
    "Publish!start": {
      "topicName": "/patrol_command",
      "datatype": "std_msgs/msg/String",
      "buttonText": "Devriye Başlat",
      "buttonTooltip": "patrol.py: start",
      "buttonColor": "#00a871",
      "advancedView": false,
      "value": "{\n  \"data\": \"start\"\n}"
    },
    "Publish!gohome": {
      "topicName": "/patrol_command",
      "datatype": "std_msgs/msg/String",
      "buttonText": "Üsse Dön",
      "buttonTooltip": "patrol.py: go_home",
      "buttonColor": "#0a84ff",
      "advancedView": false,
      "value": "{\n  \"data\": \"go_home\"\n}"
    },
    "Publish!stop": {
      "topicName": "/patrol_command",
      "datatype": "std_msgs/msg/String",
      "buttonText": "DURDUR",
      "buttonTooltip": "patrol.py: stop (her şeyi keser)",
      "buttonColor": "#ff3b30",
      "advancedView": false,
      "value": "{\n  \"data\": \"stop\"\n}"
    },
    "Plot!speed": {
      "paths": [
        { "value": "/odom.twist.twist.linear.x", "enabled": true, "timestampMethod": "receiveTime", "label": "odom v (m/s)" },
        { "value": "/cmd_vel.linear.x", "enabled": true, "timestampMethod": "receiveTime", "label": "cmd_vel v (m/s)" },
        { "value": "/odom.twist.twist.angular.z", "enabled": true, "timestampMethod": "receiveTime", "label": "odom w (rad/s)" }
