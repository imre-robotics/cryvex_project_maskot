<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cryvex_isaac</name>
  <version>0.1.0</version>
  <description>
    Cryvex kafe robotu: NVIDIA Isaac Sim 6.1 simulasyonu (fizik + sensorler) ve
    Foxglove gorsellestirmesi. ROS tarafi cryvex_gazebo'daki patrol.py /
    tablet_server.py / Nav2 kurulumunu degistirmeden kullanir.
  </description>
  <maintainer email="mustafa.imre810@gmail.com">main</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>cryvex_description</exec_depend>
  <exec_depend>cryvex_gazebo</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
