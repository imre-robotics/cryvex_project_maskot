<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="cafe_world">
    <!-- ================================================================ -->
    <!--                        ENVIRONMENT                               -->
    <!--  Spacious cafe: 17m x 14m (~240 m²)                              -->
    <!-- ================================================================ -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <!-- 6 ceiling lights for the larger space -->
    <light name="ceiling_light_1" type="point">
      <pose>-5 -3 2.8 0 0 0</pose>
      <diffuse>0.9 0.85 0.7 1</diffuse><specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>12</range><constant>0.3</constant><linear>0.04</linear><quadratic>0.008</quadratic></attenuation>
    </light>
    <light name="ceiling_light_2" type="point">
