<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cryvex">

  <!-- Malzeme Tanımlamaları -->
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <!-- Bumblebee sarısı: govde/kaporta bu renkte, teker/gozde/sensor/ekran siyah kaliyor -->
  <material name="bee_yellow">
    <color rgba="1.0 0.78 0.0 1"/>
  </material>

  <!-- Base Footprint -->
  <link name="base_footprint"/>

  <!-- Base Link (Alt Gövde) -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.25" length="0.15"/></geometry>
      <material name="bee_yellow"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.25" length="0.15"/></geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.26" ixy="0.0" ixz="0.0" iyy="0.26" iyz="0.0" izz="0.46"/>
    </inertial>
  </link>
  <gazebo reference="base_link"><material>Gazebo/Yellow</material></gazebo>

  <!-- Gövde ve Raflar (Body) -->
  <joint name="body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="-0.05 0 0.55" rpy="0 0 0"/>
  </joint>
  
  <link name="body_link">
    <visual>
      <geometry><box size="0.3 0.4 0.95"/></geometry>
      <material name="bee_yellow"/>
    </visual>
    <collision>
      <geometry><box size="0.3 0.4 0.95"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.4" ixy="0.0" ixz="0.0" iyy="0.4" iyz="0.0" izz="0.06"/>
    </inertial>
  </link>
  <gazebo reference="body_link"><material>Gazebo/Yellow</material></gazebo>

  <!-- Ekran (Tablet Bölümü - Göğüs Yüzeyine Yapışık) -->
  <joint name="head_joint" type="fixed">
    <parent link="body_link"/>
    <child link="head_link"/>
    <!-- Gövdenin tam ön yüzeyine (x=0.155) yapıştırıldı ve üst kısımdan biraz aşağıya (z=0.25) hizalandı -->
    <origin xyz="0.155 0 0.25" rpy="0 0 0"/>
  </joint>
  
  <link name="head_link">
    <visual>
      <!-- Tablet kalınlığı 2 cm (0.02), genişlik 25 cm, yükseklik 15 cm -->
      <geometry><box size="0.02 0.25 0.15"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.25 0.15"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <gazebo reference="head_link"><material>Gazebo/Black</material></gazebo>

  <!-- Sağ ve Sol Motor Tekerlekleri (BLDC Hub) -->
  <xacro:macro name="wheel" params="prefix y_reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${y_reflect * 0.28} -0.05" rpy="-1.5707 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}_wheel">
      <visual>
        <geometry><cylinder radius="0.0825" length="0.05"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.0825" length="0.05"/></geometry>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.006"/>
      </inertial>
    </link>
    <gazebo reference="${prefix}_wheel"><material>Gazebo/Black</material></gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left" y_reflect="1"/>
  <xacro:wheel prefix="right" y_reflect="-1"/>

  <!-- Sarhoş Tekerlekler (Caster Wheels) -->
  <xacro:macro name="caster" params="prefix x_offset">
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster"/>
      <origin xyz="${x_offset} 0 -0.08" rpy="0 0 0"/>
    </joint>
    
    <link name="${prefix}_caster">
      <visual>
        <geometry><sphere radius="0.0525"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><sphere radius="0.0525"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
      </inertial>
    </link>
    
    <gazebo reference="${prefix}_caster">
      <material>Gazebo/Black</material>
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster prefix="front" x_offset="0.18"/>
  <xacro:caster prefix="rear" x_offset="-0.18"/>

  <!-- Gazebo Diferansiyel Sürüş Eklentisi -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.56</wheel_separation>
      <wheel_diameter>0.165</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ================= SENSÖRLER ================= -->

  <!-- 3D LiDAR (Unitree 4D L1 Temsili) -->
  <joint name="lidar_joint" type="fixed">
    <parent link="body_link"/>
    <child link="lidar_link"/>
    <!-- ÖNEMLİ DEĞİŞİKLİK: Lidar gövdenin ön yüzeyine (x=0.16) ve yere daha yakın bir hizaya (z=-0.3) alındı -->
    <origin xyz="0.16 0 -0.3" rpy="0 0 0"/>
  </joint>
  
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Gazebo 3D LiDAR (PointCloud2) Eklentisi -->
  <gazebo reference="lidar_link">
    <material>Gazebo/DarkGrey</material>
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize> <!-- Gazebo'da mavi çizgileri görmek istersen true yap -->
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <!-- Örnek sayısını yarıya düşürdük (180 derece için 180 örnek) -->
            <samples>180</samples>
            <resolution>1</resolution>
            <!-- AÇILARI 180 DERECEYE KISTIK (-90 ile +90 arası) -->
            <min_angle>-1.5707</min_angle>
            <max_angle>1.5707</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <!-- AÇIYI GERİ VERDİK: Artık aşağıya doğru da 3D tarama yapabilir -->
            <min_angle>-0.26</min_angle> 
            <max_angle>0.26</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============ 4x HC-SR04 Ultrasonik (kurtulma manevrası için) ============ -->
  <!-- Tabana köşelere, ~8 cm yükseğe. LiDAR'ın göremediği alçak engelleri (sandalye
       ayağı, ayak) yakalar. 10 cm altında bir şey görünce patrol.py ters yöne kaçar.
       ÖNEMLİ: FOV ±0.35 rad (~20°) genişletildi ve montaj açıları merkeze (±0.30 rad)
       yaklaştırıldı ki ön-sol/ön-sağ sensörlerin arasında TAM ÖNDE kör nokta kalmasın -
       önceki ±30° dar-huzmeli montajda robot bir masaya DÜZ yaklaşınca hiçbir sensör
       onu görmüyordu (kör nokta), robot siyah noktaya kadar dayanıp kilitleniyordu. -->
  <xacro:macro name="sonar" params="name x y yaw">
    <joint name="sonar_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="sonar_${name}_link"/>
      <origin xyz="${x} ${y} -0.02" rpy="0 0 ${yaw}"/>
    </joint>
    <link name="sonar_${name}_link">
      <visual>
        <geometry><box size="0.02 0.045 0.02"/></geometry>
        <material name="black"/>
      </visual>
    </link>
    <gazebo reference="sonar_${name}_link">
      <material>Gazebo/Black</material>
      <sensor type="ray" name="sonar_${name}">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>15</update_rate>
        <ray>
          <scan>
            <horizontal><samples>11</samples><resolution>1</resolution>
              <min_angle>-0.35</min_angle><max_angle>0.35</max_angle></horizontal>
            <vertical><samples>5</samples><resolution>1</resolution>
              <min_angle>-0.06</min_angle><max_angle>0.06</max_angle></vertical>
          </scan>
          <range><min>0.02</min><max>0.60</max><resolution>0.01</resolution></range>
        </ray>
        <plugin name="sonar_${name}_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=ultrasonic/${name}</remapping>
          </ros>
          <output_type>sensor_msgs/Range</output_type>
          <frame_name>sonar_${name}_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- FL(+17°) ve FR(-17°) huzmeleri (±20°) tam onde ust uste biner -> kor nokta yok.
       Ayni mantik RL/RR ile tam arkada da gecerli. -->
  <xacro:sonar name="fl" x="0.20"  y="0.13"  yaw="0.30"/>   <!-- ön-sol  ~+17° -->
  <xacro:sonar name="fr" x="0.20"  y="-0.13" yaw="-0.30"/>  <!-- ön-sağ  ~-17° -->
  <xacro:sonar name="rl" x="-0.20" y="0.13"  yaw="2.84"/>   <!-- arka-sol ~+163° -->
  <xacro:sonar name="rr" x="-0.20" y="-0.13" yaw="-2.84"/>  <!-- arka-sağ ~-163° -->

  <!-- Kamera (Tablet Üzeri) -->
  <joint name="camera_joint" type="fixed">
    <parent link="body_link"/>
    <child link="camera_link"/>
    <!-- Tabletin (z=0.25) hemen üstüne (z=0.34) hizalandı -->
    <origin xyz="0.155 0 0.34" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.05 0.02"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Gazebo Kamera Eklentisi -->
  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <sensor type="camera" name="camera_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>100</far>
        </clip>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <camera_name>tablet_camera</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>