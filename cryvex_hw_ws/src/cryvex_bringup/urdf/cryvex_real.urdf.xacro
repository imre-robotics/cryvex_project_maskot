<?xml version="1.0"?>
<!--
  Cryvex gercek robot - MINIMAL iskelet URDF.

  Amaci gorsellik (RViz) degil, TF agacini TAMAMLAMAK: Nav2/SLAM, /scan'in
  geldigi lidar_link ile robotun govde cercevesi (base_link/base_footprint)
  arasinda sabit bir donusum OLMADAN calismaz ("could not transform" hatasi
  ile aninda durur). Bu dosya olmadan gercek robotta navigation.launch.py/
  mapping.launch.py ilk denemede patlar - Aşama 4 baslamadan once bu yuzden
  simdiden eklendi.

  ASAGIDAKI OLCULER YER TUTUCUDUR (gercek olculmedi, kasa/govde henuz
  kurulmadi) - tek yapilmasi gereken sasi fiziksel olarak kurulunca bu 3
  xacro property'sini gercek degerlerle degistirmek, TF agacinin YAPISI
  (parent/child iliskileri) degismeyecek:
    - base_height          : zeminden base_link'e (govde merkezi) yukseklik
    - lidar_height          : base_link'ten lidar_link'e yukseklik
    - footprint_radius      : govdenin en genis yeri / 2 (nav2_params.yaml
                               robot_radius ile AYNI TUTULMALI)

  lidar_height ONERISI: T-mini Plus'i masa/sandalye AYAKLARINI gorecek kadar
  ALCAK monte edin (~0.20-0.30 m zeminden) - cok yuksek monte edilirse masa
  tablasinin ustunden gecen taramalar bacaklari/tabure ayaklarini kacirir,
  bu da patrol.py'nin HC-SR04 destekli kacinmasina asiri yuk bindirir.
-->
<robot name="cryvex_real" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="footprint_radius" value="0.30"/>  <!-- 2026-10-05: tekerden tekere 59 cm olculdu (R 0.295), 0.30 korundu -->
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="lidar_height" value="0.36"/>  <!-- 2026-10-05: kamera eklenirken LiDAR yukseltildi, yerden 36 cm -->
  <!-- LiDAR konumu/acisi - GECERLI DEGERLER (2026-10-05, robotta calisan kurulum):
       LiDAR kamera taretiyle birlikte YENIDEN TAKILDI; ayni zamanda robotun
       "on"u ters cevrildi (stm32_bridge.py YON_DUZELTME: ileri komutunun isareti
       ve sol/sag teker sayaclari Pi tarafinda cevriliyor, STM32 yazilimi ayni).
       Bu yuzden 2026-10-02'deki ICP olcumleri (x 0.103, y -0.131, yaw -123)
       artik GECERSIZ - eski govdeye ve eski "on"a aitti.
       Yeniden olcmek icin: docs/gercek_robot.md "LiDAR'i cetvel olarak kullanmak".
       Not: LiDAR duzlemi 36 cm'de; bunun altindaki masa ayagi tabani, kablo,
       palet alti gorulmez (bkz. docs/GUNLUK.md, ToF sensorleri planli). -->
  <xacro:property name="lidar_x" value="0.125"/>
  <xacro:property name="lidar_y" value="-0.045"/>
  <xacro:property name="lidar_yaw" value="${radians(-90)}"/>


  <material name="cryvex_dark">
    <color rgba="0.08 0.08 0.10 1.0"/>
  </material>
  <material name="cryvex_cyan">
    <color rgba="0.0 0.7 0.85 1.0"/>
  </material>

  <!-- REP-120: base_footprint zeminin izdüşümü, gercek gövde base_link -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${footprint_radius}" length="${base_height}"/>
      </geometry>
      <material name="cryvex_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${footprint_radius}" length="${base_height}"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- YDLIDAR T-mini Plus - config/ydlidar_tmini_plus.yaml frame_id ile AYNI isim -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="cryvex_cyan"/>
    </visual>
  </link>

  <joint name="base_link_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_height}" rpy="0 0 ${lidar_yaw}"/>
  </joint>

  <!-- ============ 6x HC-SR04 (STM32 1.4.0 -> stm32_bridge -> /ultrasonic/*) ============
       stm32_bridge her Range mesajini frame_id = sonar_<ad>_link ile yayinlar;
       Nav2'nin range katmani bu cercevelere TF ister.
       2026-10-23 YERLESIM: govde SEKIZGEN, 6 sensor cevrede ESIT ARALIKLA (60
       derecede bir), hepsi merkezden DISARI bakar ("on" = +x = kamera tarafi):
                       fc 0
             fl +60          fr -60
             rl +120         rr -120
                      rc 180
       Sekizgenin kenar normalleri 0/45/90/135... derecede. 0 ve 180'deki sensor
       kenar ortasinda (merkeze uzaklik = sekizgen_a); +-60 ve +-120'dekiler
       45/135'lik kenarda, kose tarafina 15 derece kaymis noktada:
       uzaklik = sekizgen_a / cos(15 derece), sensor kenara gore 15 derece
       egik (dis bakan) takilir.
       OLCULER YER TUTUCU: govde bitince sekizgen_a ve sonar_z'yi olcun. -->
  <xacro:property name="sekizgen_a" value="0.26"/>   <!-- merkezden kenar ortasina (m); karsilikli kenarlar arasi / 2 -->
  <xacro:property name="sonar_z" value="0.12"/>      <!-- zeminden yukseklik (m) -->

  <xacro:macro name="sonar" params="name aci r">
    <link name="sonar_${name}_link"/>
    <joint name="base_link_to_sonar_${name}" type="fixed">
      <parent link="base_link"/>
      <child link="sonar_${name}_link"/>
      <origin xyz="${r*cos(radians(aci))} ${r*sin(radians(aci))} ${sonar_z}" rpy="0 0 ${radians(aci)}"/>
    </joint>
  </xacro:macro>

  <xacro:sonar name="fc" aci="0"    r="${sekizgen_a}"/>
  <xacro:sonar name="fl" aci="60"   r="${sekizgen_a/cos(radians(15))}"/>
  <xacro:sonar name="rl" aci="120"  r="${sekizgen_a/cos(radians(15))}"/>
  <xacro:sonar name="rc" aci="180"  r="${sekizgen_a}"/>
  <xacro:sonar name="rr" aci="-120" r="${sekizgen_a/cos(radians(15))}"/>
  <xacro:sonar name="fr" aci="-60"  r="${sekizgen_a/cos(radians(15))}"/>

  <!-- MPU6050 - stm32_bridge.py sadece Z ekseni acisal hizini yayinliyor,
       konum onemsiz; kart DUZ (Z yukari) monte edilmezse buraya rpy eklenmeli. -->
  <link name="imu_link"/>

  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

</robot>
